---
import { recentExperience } from '../data/experience';

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<ol class="flex max-w-3xl flex-col gap-8">
  {
    recentExperience.map((entry) => (
      <li class="border-l-2 border-teal-100 pl-6">
        <h3 class="text-xl font-medium text-slate-700">
          {entry.organization} — {entry.title}
        </h3>
        <p class="mt-1 text-sm text-slate-500">
          {entry.kind === 'employment' ? 'Employment' : 'Co-founder'} ·{' '}
          <time datetime={entry.startTime.toISOString().slice(0, 7)}>
            {dateFormatter.format(entry.startTime)}
          </time>
          {' – '}
          {entry.endTime ? (
            <time datetime={entry.endTime.toISOString().slice(0, 7)}>
              {dateFormatter.format(entry.endTime)}
            </time>
          ) : (
            'present'
          )}
        </p>
        {entry.description && <p class="mt-3">{entry.description}</p>}
      </li>
    ))
  }
</ol>
